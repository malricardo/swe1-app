option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: "ebdjango.settings"
    PYTHONPATH: "/var/app/current:$PYTHONPATH"
  aws:elasticbeanstalk:container:python:
    WSGIPath: ebdjango.wsgi:application

container_commands:
  01_migrate:
    command: "python manage.py migrate --noinput"
    leader_only: true
  02_load_poll_data:
    command: "python manage.py loaddata polls/fixtures/polls_data.json"
    leader_only: true
  # Let the Django worker write to the SQLite database after seeding it.
  03_db_permissions:
    command: "chown webapp:webapp db.sqlite3 . && chmod 664 db.sqlite3"
    leader_only: true
